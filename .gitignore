# --- Assets: deliberately NOT tracked ---
# foxy.png / scream.wav are copyrighted FNAF material. Keeping them out of the
# repo means a DMCA notice costs us a re-upload, not the repository.
# Populate locally per assets/PACK.md.
# Screenshots of the overlay show the asset itself, so committing them would
# put the copyrighted frames in the repo through the back door. Regenerate
# locally with: FOXY_CAPTURE=1 npx playwright test _demo
docs/screenshots/

assets/*.mp4
assets/*.webm
assets/*.mov
assets/*.png
assets/*.jpg
assets/*.wav
assets/*.ogg
assets/*.mp3

# --- Node / extension ---
node_modules/
dist/
*.zip
*.xpi

# --- .NET / desktop ---
[Bb]in/
[Oo]bj/
*.user
.vs/

# --- Stale config copied in from another project ---
# Kept on disk in case something in it is wanted; never committed, since this
# repo is public and that content is unrelated internal tooling.
.claude/_archive-wellnessscape/
.claude/settings.local.json

# --- Credentials ---
# AMO signing key/secret. Anyone holding these can publish updates under our
# add-on id, which is a supply-chain problem, not an inconvenience.
.amo-credentials.json
web-ext-artifacts/

# --- Tooling scratch ---
.playwright-mcp/
test-results/
playwright-report/

# --- OS / editor ---
Thumbs.db
.DS_Store
.idea/

# --- build output ---
dist/packages/
