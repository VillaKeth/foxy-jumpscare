{
  "name": "foxy-jumpscare",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node tools/build-assets.mjs",
    "build": "node tools/build-extension.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:firefox": "addons-linter dist/firefox",
    "lint:package": "addons-linter dist/packages/foxy-jumpscare-firefox-v0.1.1.zip",
    "verify:firefox": "node tools/verify-firefox.mjs",
    "dev:firefox": "node tools/firefox-dist.mjs run",
    "sign:firefox": "node tools/firefox-dist.mjs sign",
    "publish:firefox": "node tools/firefox-dist.mjs publish",
    "verify:desktop": "pwsh -NoProfile -File tools/verify-desktop.ps1",
    "icons": "node tools/make-icons.mjs",
    "package": "node tools/package.mjs",
    "package:source": "node tools/package-source.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "addons-linter": "^10.9.0",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0"
  }
}
