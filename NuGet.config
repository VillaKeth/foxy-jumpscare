<?xml version="1.0" encoding="utf-8"?>
<!--
  This machine had no NuGet sources configured at all, so restore failed with
  NU1100 for every package. Declaring the source here rather than in the user's
  global config keeps the repo self-contained and reproducible on a fresh box.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
