<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The overlay copies decoded video frames into a shared bitmap with a
         per-row memcpy, so every monitor shows the same frame in lock-step. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FoxyJumpscare</AssemblyName>
    <RootNamespace>FoxyJumpscare</RootNamespace>

    <!-- Embedded exe icon: Task Manager, Explorer, Alt-Tab. The settings window
         also sets it at runtime for its taskbar button. Conditional on the
         gitignored asset, so a bare checkout still builds. -->
    <ApplicationIcon Condition="Exists('..\..\assets\foxy.ico')">..\..\assets\foxy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Windows-only API. Referenced from a cross-platform net8.0 build, but
         only ever exercised behind an OperatingSystem.IsWindows() guard. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />

    <!-- Cross-platform video. Avalonia has no built-in player; LibVLCSharp is
         the mature option. The native libVLC is pulled per platform: the
         VideoLAN.LibVLC.Windows package on a Windows build, and the system
         libvlc (apt/brew) on Linux and macOS. Conditioned on the BUILD host,
         which is also the target here. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoxyJumpscare.Core\FoxyJumpscare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assets from the pack, optional so the app builds before it exists. -->
    <None Include="..\..\assets\foxy.mp4" Condition="Exists('..\..\assets\foxy.mp4')"
          CopyToOutputDirectory="PreserveNewest" Link="foxy.mp4" />
    <!-- [colour | alpha] side by side; lets the overlay be transparent. -->
    <None Include="..\..\assets\foxy-alpha.mp4" Condition="Exists('..\..\assets\foxy-alpha.mp4')"
          CopyToOutputDirectory="PreserveNewest" Link="foxy-alpha.mp4" />
    <None Include="..\..\assets\foxy.ico" Condition="Exists('..\..\assets\foxy.ico')"
          CopyToOutputDirectory="PreserveNewest" Link="foxy.ico" />
  </ItemGroup>

</Project>
