<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoxyJumpscare.Views.SettingsWindow"
        Title="Foxy Jumpscare"
        Width="340" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark"
        Background="#1C1A1D">

  <StackPanel Margin="16">
    <TextBlock Text="Foxy Jumpscare" FontSize="16" FontWeight="SemiBold" Foreground="#ECE7E9" />
    <TextBlock x:Name="OddsNote" Foreground="#A09AA4" FontSize="12"
               Margin="0,2,0,14" TextWrapping="Wrap" />

    <CheckBox x:Name="EnabledCheck" Content="Enabled" Foreground="#ECE7E9" Margin="0,0,0,4" />
    <CheckBox x:Name="StartupCheck" Content="Run at startup" Foreground="#ECE7E9" Margin="0,0,0,8" />

    <TextBlock Text="Rarity" Foreground="#A09AA4" FontSize="12" />
    <ComboBox x:Name="RarityCombo" Margin="0,4,0,0" HorizontalAlignment="Stretch" />

    <StackPanel x:Name="CustomPanel" Margin="0,10,0,0" IsVisible="False">
      <TextBlock Text="1 in N chance, every active second" Foreground="#A09AA4" FontSize="12" />
      <TextBox x:Name="CustomBox" Margin="0,4,0,0" />
    </StackPanel>

    <Border BorderBrush="#3A363C" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
      <TextBlock x:Name="CountdownText" Foreground="#ECE7E9" TextWrapping="Wrap" />
    </Border>

    <TextBlock x:Name="StatusText" Foreground="#BE3A1A" FontSize="12" MinHeight="16" Margin="0,8,0,0" />

    <Button x:Name="TestButton" Content="Test it now"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Margin="0,6,0,0" Padding="8,6"
            Background="#BE3A1A" Foreground="White" />

    <TextBlock Text="Sudden loud video and audio, by design."
               Foreground="#A09AA4" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
  </StackPanel>
</Window>
